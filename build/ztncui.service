[Unit]
Description=ztncui - ZeroTier network controller user interface
Documentation=https://github.com/xuanranran/ztncui
After=network.target zerotier-one.service
Wants=zerotier-one.service

[Service]
Type=simple
User=ztncui
Group=ztncui
WorkingDirectory=/opt/ztncui
EnvironmentFile=-/opt/ztncui/etc/ztncui.conf
ExecStart=/opt/ztncui/ztncui
Restart=on-failure

[Install]
WantedBy=multi-user.target

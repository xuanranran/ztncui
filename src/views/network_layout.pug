extends controller_layout

block content
  if error
     b #{error}
  else
    .row.network-page-header
      .col-sm-10.network-page-main
        block network_title
          .network-identity
            .network-identity-main
              .network-identity-name
                span= network.name
              .network-identity-id
                span NETWORK ID
                code #{network.nwid}
            .network-identity-actions
              button.network-icon-btn(type='button' onclick=`copyToClipboard('${network.nwid}')` title='复制网络 ID')
                i.glyphicon.glyphicon-copy
              button.network-icon-btn(type='button' onclick=`showNetworkQr('${network.nwid}')` title='生成二维码')
                i.glyphicon.glyphicon-qrcode

          .modal.fade#networkQrModal(tabindex='-1' role='dialog')
            .modal-dialog.network-qr-dialog(role='document')
              .modal-content.network-qr-modal
                .modal-header
                  button.close(type='button' data-dismiss='modal' aria-label='关闭')
                    span(aria-hidden='true') &times;
                  h4.modal-title 加入 ZeroTier 网络
                .modal-body
                  p.network-qr-help 使用手机相机扫描二维码加入此 ZeroTier 网络
                  img#networkQrImage(alt='网络 ID 二维码')
                  .network-join-link
                    code#networkQrText https://joinzt.com/addnetwork?nwid=#{network.nwid}&v=1
                    button.network-join-copy(type='button' onclick='copyToClipboard($("#networkQrText").text())' title='复制加入链接')
                      i.glyphicon.glyphicon-copy

          script.
            function showNetworkQr(nwid) {
              var joinUrl = 'https://joinzt.com/addnetwork?nwid=' + encodeURIComponent(nwid) + '&v=1';
              $('#networkQrText').text(joinUrl);
              $('#networkQrImage').attr(
                'src',
                'https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=' + encodeURIComponent(joinUrl)
              );
              $('#networkQrModal').modal('show');
            }

            function copyToClipboard(text) {
              if (navigator.clipboard && window.isSecureContext) {
                return navigator.clipboard.writeText(text);
              }
              var textArea = document.createElement('textarea');
              textArea.value = text;
              textArea.style.position = 'fixed';
              textArea.style.opacity = '0';
              document.body.appendChild(textArea);
              textArea.select();
              document.execCommand('copy');
              document.body.removeChild(textArea);
            }
        block title
          if title
            h3= title

      .col-sm-2.network-page-back
        h2.right
          a.btn.btn-default(href=navigate.whence role='button') 返回
    block net_content

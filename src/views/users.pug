extends users_layout

block users_header
  .row(style='margin-bottom: 24px; align-items: center; display: flex;')
    .col-xs-8
      h2(style='margin: 0;') 用户
    .col-xs-4.text-right
      a.btn.btn-primary(href=(basePath + '/users/create'))
        i.glyphicon.glyphicon-plus
        |  创建用户

block users_content
  .panel.panel-default
    .panel-body(style='padding: 0 !important;')
      .table-responsive-wrapper
        table.table.table-hover(style='margin: 0;')
          thead
            tr
              th(width='55%') 用户名
              th(width='45%') 操作
          tbody
            each user in users
              tr
                td
                  a.user-list-name(href=(basePath + '/users/' + user.name + '/password'))
                    i.glyphicon.glyphicon-user
                    span= user.name
                td.action-buttons
                  a.btn.btn-sm.btn-outline-primary(href=(basePath + '/users/' + user.name + '/password'))
                    i.glyphicon.glyphicon-lock
                    span.btn-text 设置密码
                  a.btn.btn-sm.btn-outline-danger(
                    href=(basePath + '/users/' + user.name + '/delete')
                    onclick="return confirm('确定删除用户 ' + '#{user.name}' + ' 吗？')"
                  )
                    i.glyphicon.glyphicon-trash
                    span.btn-text 删除
            else
              tr
                td(colspan='2' style='text-align: center; padding: 40px;')
                  div(style='color: var(--text-muted); margin-bottom: 16px;') 暂无用户。
                  a.btn.btn-primary(href=(basePath + '/users/create')) 创建用户

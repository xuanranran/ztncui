extends network_layout
block title
block net_content
  - const multicastLimit = form ? form.multicastLimit : (network.multicastLimit === undefined ? 32 : network.multicastLimit);
  - const enableBroadcast = form ? form.enableBroadcast : !!network.enableBroadcast;
  - const privateNetwork = form ? form.privateNetwork : !!network.private;

  script.
    const initialMulticastLimit = !{JSON.stringify(multicastLimit)};
    const initialEnableBroadcast = !{JSON.stringify(enableBroadcast)};
    const initialPrivateNetwork = !{JSON.stringify(privateNetwork)};

    function resetMulticastSettings() {
      $('#multicastLimit').val(initialMulticastLimit);
      $('#enableBroadcast').prop('checked', initialEnableBroadcast);
      $('#privateNetwork').prop('checked', initialPrivateNetwork);
    }

  if message
    .alert.alert-success= message
  if errors
    .alert.alert-danger
      each err in errors
        div= err.msg

  form.multicast-page(method='POST' action='')
    .multicast-header
      h3 组播
      p 允许网络设备将数据发送给已订阅该组播的多个设备。

    .multicast-settings-grid
      .multicast-setting
        h4 组播接收者上限
        p 限制可以接收组播消息的设备数量，避免占用过多带宽。
        label.assignment-field-label(for='multicastLimit') 组播接收者上限
        input#multicastLimit.form-control.assignment-input(type='number' min='0' step='1' name='multicastLimit' value=multicastLimit required)

      .multicast-setting
        h4 广播
        p 将广播数据包发送给网络中的所有设备，包括未明确订阅的设备。
        label.assignment-switch-row.multicast-broadcast-switch(for='enableBroadcast')
          span.assignment-switch
            input#enableBroadcast.assignment-switch-input(type='checkbox' name='enableBroadcast' value='true' checked=enableBroadcast)
            span.assignment-switch-track
          span
            strong 启用广播
            small 转发以太网广播帧（ff:ff:ff:ff:ff:ff）。

    .multicast-access-setting
      h4 网络访问
      p 控制新成员加入网络后是否必须经过管理员授权。
      label.assignment-switch-row(for='privateNetwork')
        span.assignment-switch
          input#privateNetwork.assignment-switch-input(type='checkbox' name='privateNetwork' value='true' checked=privateNetwork)
          span.assignment-switch-track
        span
          strong 私有网络
          small 开启后，未经授权的新成员无法访问网络；关闭后成员加入即可访问。

    .assignment-actions
      button.btn.btn-default(type='button' onclick='resetMulticastSettings()') 重置
      button.btn.btn-primary(type='submit') 保存组播设置

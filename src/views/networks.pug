extends controller_layout

block content
  .row(style='margin-bottom: 24px; align-items: center; display: flex;')
    .col-xs-8
      h2(style='margin: 0;') Networks
    .col-xs-4.text-right
      a.btn.btn-primary(href=basePath + '/controller/network/create') 
        span.glyphicon.glyphicon-plus
        |  Create A Network

  if error
    .alert.alert-danger #{error}
  else
    .panel.panel-default
      .panel-body(style='padding: 0 !important;')
        table.table.table-hover(style='margin: 0;')
          thead
            tr
              th(width='40%') Network Name
              th(width='20%') Network ID
              th(width='15%') Type
              th(width='25%') Actions
          tbody
            each network in networks
              - const nwurl = basePath + '/controller/network/' + network.nwid;
              tr(onclick=`window.location='${nwurl}'` style='cursor: pointer;')
                td
                  div(style='font-weight: 600; color: var(--primary);') #{network.name}
                  div(style='font-size: 0.85em; color: var(--text-muted);') No description
                td
                  code(style='background: transparent; color: inherit; padding: 0;') #{network.nwid}
                td
                  span.label.label-success PRIVATE
                td(onclick='event.stopPropagation();')
                  a.btn.btn-default.btn-xs(href=nwurl style='margin-right: 8px;') Manage
                  a.btn.btn-default.btn-xs(href=nwurl + '/easy') Easy Setup
                  a.btn.btn-danger.btn-xs(href=nwurl + '/delete' style='margin-left: 8px;') 
                    i.glyphicon.glyphicon-trash

            else
              tr
                td(colspan='4' style='text-align: center; padding: 40px;')
                  div(style='color: var(--text-muted); margin-bottom: 16px;') No networks found.
                  a.btn.btn-primary(href=basePath + '/controller/network/create') Create your first network

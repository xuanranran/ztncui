extends controller_layout

block content
  .row(style='margin-bottom: 24px; align-items: center; display: flex;')
    .col-xs-8
      h2(style='margin: 0;') 网络
    .col-xs-4.text-right
      a.btn.btn-primary(href=basePath + '/network/create')
        span.glyphicon.glyphicon-plus
        |  创建网络

  if error
    .alert.alert-danger #{error}
  else
    .panel.panel-default
      .panel-body(style='padding: 0 !important;')
        .table-responsive-wrapper
          table.table.table-hover(style='margin: 0;')
            thead
              tr
                th(width='40%') 网络名称
                th(width='20%') 网络 ID
                th(width='15%') 类型
                th(width='25%') 操作
            tbody
              each network in networks
                - const nwurl = basePath + '/network/' + network.nwid;
                tr
                  td
                    a.network-list-link(href=nwurl) #{network.name}
                  td
                    div.network-id-copy(onclick=`copyToClipboard('${network.nwid}')` title='点击复制网络 ID')
                      code(style='background: transparent; color: inherit; padding: 0;') #{network.nwid}
                      i.glyphicon.glyphicon-copy
                  td
                    span.label.label-success 私有
                  td.action-buttons(onclick='event.stopPropagation();')
                    a.btn.btn-sm.btn-outline-primary(href=nwurl)
                      i.glyphicon.glyphicon-cog
                      span.btn-text 管理
                    a.btn.btn-sm.btn-outline-danger(href=nwurl + '/delete')
                      i.glyphicon.glyphicon-trash
                      span.btn-text 删除

              else
                tr
                  td(colspan='4' style='text-align: center; padding: 40px;')
                    div(style='color: var(--text-muted); margin-bottom: 16px;') 未找到网络。
                    a.btn.btn-primary(href=basePath + '/network/create') 创建您的第一个网络

    if zt_status
      .controller-status-summary
        div
          span 此网络控制器的零层地址为
          code= zt_status.address
        div
          span ZeroTier 版本
          code= zt_status.version

  script.
    function copyToClipboard(text) {
      if (navigator.clipboard) {
        navigator.clipboard.writeText(text).then(showToast, (err) => console.error('Copy failed', err));
      } else {
        var textArea = document.createElement("textarea");
        textArea.value = text;
        document.body.appendChild(textArea);
        textArea.select();
        try { document.execCommand('copy'); showToast(); } catch (err) {}
        document.body.removeChild(textArea);
      }

      function showToast() {
        var toast = document.createElement('div');
        toast.innerText = '已复制: ' + text;
        toast.style.position = 'fixed';
        toast.style.bottom = '24px';
        toast.style.left = '50%';
        toast.style.transform = 'translateX(-50%)';
        toast.style.backgroundColor = 'rgba(22, 28, 36, 0.9)';
        toast.style.color = '#fff';
        toast.style.padding = '8px 16px';
        toast.style.borderRadius = '8px';
        toast.style.zIndex = '9999';
        toast.style.fontSize = '0.9rem';
        toast.style.boxShadow = '0 4px 12px rgba(0,0,0,0.15)';
        document.body.appendChild(toast);
        setTimeout(() => {
          toast.style.transition = 'opacity 0.5s ease';
          toast.style.opacity = '0';
          setTimeout(() => document.body.removeChild(toast), 500);
        }, 2000);
      }
    }

extends network_layout
block title
block net_content
  script.
    const quickIPv4Pools = [
      '10.147.17.*', '10.147.18.*', '10.147.19.*', '10.147.20.*',
      '10.144.*.*', '10.241.*.*', '10.242.*.*', '10.243.*.*',
      '10.244.*.*', '172.22.*.*', '172.23.*.*', '172.24.*.*',
      '172.25.*.*', '172.26.*.*', '172.27.*.*', '172.28.*.*',
      '172.29.*.*', '172.30.*.*', '192.168.191.*', '192.168.192.*',
      '192.168.193.*', '192.168.194.*', '192.168.195.*', '192.168.196.*'
    ];

    function poolFromPattern(pattern) {
      const parts = pattern.split('.');
      if (parts.length !== 4) return null;
      if (parts[2] === '*' && parts[3] === '*') {
        return {
          ipRangeStart: parts[0] + '.' + parts[1] + '.0.1',
          ipRangeEnd: parts[0] + '.' + parts[1] + '.255.254'
        };
      }
      if (parts[3] === '*') {
        return {
          ipRangeStart: parts[0] + '.' + parts[1] + '.' + parts[2] + '.1',
          ipRangeEnd: parts[0] + '.' + parts[1] + '.' + parts[2] + '.254'
        };
      }
      return null;
    }

    function applyPool(pool, message) {
      $('#ipRangeStart').val(pool.ipRangeStart);
      $('#ipRangeEnd').val(pool.ipRangeEnd);
      if (message) $('.pool-hint').text(message);
    }

    function renderQuickPools() {
      const grid = $('#quickIPv4Grid');
      quickIPv4Pools.forEach(function(pattern) {
        const button = $('<button/>', {
          type: 'button',
          class: 'pool-preset',
          text: pattern,
          'data-pattern': pattern
        });
        grid.append(button);
      });
    }

    $(function() {
      renderQuickPools();

      $('.pool-mode-tab').on('click', function() {
        const mode = $(this).data('mode');
        $('.pool-mode-tab').removeClass('active');
        $(this).addClass('active');
        $('.pool-mode-pane').hide();
        $('#' + mode + 'PoolPane').show();
      });

      $('.pool-preset').on('click', function() {
        const pattern = $(this).data('pattern');
        const pool = poolFromPattern(pattern);
        if (!pool) return;
        $('.pool-preset').removeClass('active');
        $(this).addClass('active');
        applyPool(pool, '已选择 ' + pattern + '，可直接提交或继续手动调整。');
      });

      $('#generateIPv6Btn').on('click', function() {
        const nwid = '#{network.nwid}';
        $.ajax({
          url: '#{basePath}/network/' + nwid + '/api/generateIPv6Pool',
          method: 'GET',
          success: function(response) {
            if (response.success) {
              applyPool(response.pool, response.message || 'IPv6 地址池已生成，可直接提交。');
            }
          },
          error: function() {
            alert('生成 IPv6 池失败，请重试');
          }
        });
      });

      $('#generateIPv4Btn').on('click', function() {
        const nwid = '#{network.nwid}';
        $.ajax({
          url: '#{basePath}/network/' + nwid + '/api/generateIPv4Pool',
          method: 'GET',
          success: function(response) {
            if (response.success) {
              $('.pool-preset').removeClass('active');
              applyPool(response.pool, response.message || 'IPv4 地址池已生成，可直接提交。');
            }
          },
          error: function() {
            alert('生成 IPv4 池失败，请重试');
          }
        });
      });
    });

  .row
    .col-sm-12
      h3 当前 IP 分配池
      if network.ipAssignmentPools && network.ipAssignmentPools.length > 0
        table.table.table-responsive.table-striped.table-hover
          tr
            th
            th IP范围开始
            th IP范围结束
            th 类型
          each ipAssignmentPool in network.ipAssignmentPools
            - const isIPv6 = ipAssignmentPool.ipRangeStart.includes(':');
            tr
              td(width='3%')
                a(href=(basePath + '/network/' + network.nwid + '/ipAssignmentPools/' + ipAssignmentPool.ipRangeStart + '/' + ipAssignmentPool.ipRangeEnd + '/delete'))
                  i.glyphicon.glyphicon-trash  
              td
                span(style=`font-family: var(--font-mono); color: ${isIPv6 ? '#4CAF50' : '#2196F3'};`)= ipAssignmentPool.ipRangeStart
              td
                span(style=`font-family: var(--font-mono); color: ${isIPv6 ? '#4CAF50' : '#2196F3'};`)= ipAssignmentPool.ipRangeEnd
              td
                if isIPv6
                  span.label.label-success 🌐 IPv6
                else
                  span.label.label-primary IPv4
      else
        p(style='color: var(--text-muted); margin: 20px 0;') 暂无 IP 分配池

  .row
    .col-sm-12
      h3 添加新的IP分配池

  .pool-builder
    .pool-mode-tabs
      button.pool-mode-tab.active(type='button' data-mode='easy') 常用网段
      button.pool-mode-tab(type='button' data-mode='advanced') 手动输入

    #easyPoolPane.pool-mode-pane
      .pool-toolbar
        button#generateIPv4Btn.btn.btn-primary(type='button')
          i.glyphicon.glyphicon-random
          |  随机生成 IPv4
        button#generateIPv6Btn.btn.btn-success(type='button')
          i.glyphicon.glyphicon-flash
          |  自动生成 IPv6
      #quickIPv4Grid.pool-preset-grid
      .pool-hint 选择常用网段后会自动填写下方地址池范围。

    #advancedPoolPane.pool-mode-pane(style='display: none;')
      .pool-hint 手动填写下面的开始/结束地址，支持 IPv4 和 IPv6。

  form(method='POST' action=(basePath + '/network/' + network.nwid + '/ipAssignmentPools'))
    .form-group.row
      .col-sm-2
        label(for='ipRangeStart') IP范围开始:
      .col-sm-12
        input#ipRangeStart.form-control(type='text' name='ipRangeStart' placeholder='例如: 10.0.0.1 或 fd00::1' value=(undefined===ipAssignmentPool? '' : ipAssignmentPool.ipRangeStart))
        small.form-text.text-muted 支持 IPv4 和 IPv6 地址

    .form-group.row
      .col-sm-2
        label(for='ipRangeEnd') IP范围结束:
      .col-sm-12
        input#ipRangeEnd.form-control(type='text' name='ipRangeEnd' placeholder='例如: 10.0.0.254 或 fd00::ffff' value=(undefined===ipAssignmentPool? '' : ipAssignmentPool.ipRangeEnd))
        small.form-text.text-muted 支持 IPv4 和 IPv6 地址

    .form-group.row
      .col-sm-12
        button.btn.btn-primary(type='submit') 提交
        = ' '
        a.btn.btn-default(href=(basePath + '/network/' + network.nwid) name='cancel' role='button') 取消

  if errors
    .row
      .col-sm-12
        ul
          for err in errors
            li!= err.msg

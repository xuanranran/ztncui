extends login_layout

block login_content
  .auth-wrapper
    .auth-page-note ZeroTier 网络控制器 - 安全、易管理、高性能的虚拟网络
    .auth-main
      .auth-card
        div(style='text-align: center; margin-bottom: 32px;')
          h2 登录
          p 请输入您的账户凭据以继续。

        if error
           .alert.alert-danger #{error}
        if message
           .alert.alert-info #{message}

        form(method='POST' action='')
          .form-group
            label(for='username') 用户名
            input#username.form-control(type='text' name='username' value='admin' placeholder='请输入用户名' autocomplete='username')
          
          .form-group
            label(for='password') 密码
            input#password.form-control(type='password' name='password' placeholder='请输入密码')
            
          .form-group(style='margin-top: 32px;')
            button.btn.btn-primary.btn-block.btn-lg(type='submit' style='width: 100%;') 登录

extends network_layout

block net_content
  if errors
    .row
      .col-sm-12
        .alert.alert-warning
          b 注意下面列出的错误

  form(method='POST' action='')

    .row
      .col-sm-6
        h4 成员名称:
          b= member.name
      .col-sm-6.right
        h4 ZeroTier地址:
          b= member.id

    .row
      .col-sm-12
        .checkbox
          label
            input#noAutoAssignIps(type='checkbox' checked=(member.noAutoAssignIps? true : false))
            |  禁止自动分配 IP (noAutoAssignIps)
        div(style='font-size: 0.85em; color: var(--text-muted);') 勾选后控制器不会从地址池自动给该成员分配 IP, 只使用上面手动指定的地址。
        script.
          $(function() {
            $('#noAutoAssignIps').on('change', function() {
              $.post('#{basePath}/network/#{network.nwid}/member/#{member.id}/noAutoAssignIps', { noAutoAssignIps: this.checked });
            });
          });

    .row
      .col-sm-12
        table.table.table-responsive.table-striped.table-hover
          tr
            th(width='3%')
            th IP地址

          each ipAssignment, index in member.ipAssignments
            - const isIPv6 = ipAssignment.includes(':');
            tr
              td(width='3%')
                a.btn.btn-link(role='button' href=(basePath + '/network/' + network.nwid + '/member/' + member.id + '/ipAssignments/' + index + '/delete'))
                  i.glyphicon.glyphicon-trash
              td
                span(style=`font-family: var(--font-mono); padding: 4px 12px; border-radius: 4px; background: ${isIPv6 ? 'rgba(76, 175, 80, 0.1)' : 'rgba(33, 150, 243, 0.1)'}; color: ${isIPv6 ? '#4CAF50' : '#2196F3'}; display: inline-flex; align-items: center; gap: 6px;`)
                  if isIPv6
                    span 🌐
                  | #{ipAssignment}

          tr
            td
              button.btn.btn-link(type='submit')
                i.glyphicon.glyphicon-plus
            td
              input#ipAddress.form-control(type='text' name='ipAddress' placeholder='IP地址' value=(undefined===ipAssignment? '' : ipAssignment.ipAddress))

    .row
      .col-sm-12
        a(href=(basePath + '/network/' + network.nwid + '/routes'))
          h3 管理的路由
        table.table.table-responsive.table-striped.table-hover
          tr
            th
            th 目标
            th 网关
            each route in network.routes
              tr
                td(width='3%')
                  a.btn.btn-link(role='button' href=(basePath + '/network/' + network.nwid + '/routes/' + route.target + '/delete'))
                    i.glyphicon.glyphicon-trash
                td= route.target
                td= route.via

  if errors
    .row
      .col-sm-12
        ul
          for err in errors
            li!= err.msg

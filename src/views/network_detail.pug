extends network_layout

//- Don't display that title
block title

block net_content
  - const nwurl = basePath + '/network/' + network.nwid;
  - const currentIpSort = typeof ipSort === 'undefined' ? '' : ipSort;

  // Settings Card
  .panel.panel-default
    .panel-heading 设置
    .panel-body
      .row
        .col-md-12
          div.settings-grid(style='display: flex; gap: 10px; flex-wrap: wrap;')
            a.btn.btn-default(href=(nwurl + '/details')) 网络详情
            a.btn.btn-default(href=(nwurl + '/v4AssignMode')) IPv4 分配
            a.btn.btn-default(href=(nwurl + '/v6AssignMode')) IPv6 分配
            a.btn.btn-default(href=(nwurl + '/routes')) 托管路由
            a.btn.btn-default(href=(nwurl + '/dns')) DNS
            a.btn.btn-default(href=(nwurl + '/advanced')) 组播

  if (members !== undefined)
    - 
      let onlineCount = 0;
      let offlineCount = 0;
      let unauthCount = 0;
      members.forEach(m => {
        if (m.peer) onlineCount++;
        else offlineCount++;
        if (!m.authorized) unauthCount++;
      });

    // Members Card
    .panel.panel-default
      .panel-heading 
        | 成员
        span.badge(style='margin-left: 12px; background-color: rgba(34, 197, 94, 0.1); color: #22C55E; font-weight: 600;' title='在线设备') 在线 #{onlineCount}
        span.badge(style='margin-left: 8px; background-color: rgba(255, 72, 66, 0.1); color: #FF4842; font-weight: 600;' title='离线设备') 离线 #{offlineCount}
        if unauthCount > 0
          span.badge(style='margin-left: 8px; background-color: rgba(0, 0, 0, 0.08); color: #333; font-weight: 600;' title='未授权设备') 未授权 #{unauthCount}
        else
           span.badge(style='margin-left: 8px; background-color: rgba(0, 0, 0, 0.08); color: #333; font-weight: 600;' title='未授权设备') 未授权 #{unauthCount}
      
      script.
        $(function() {
          const url = "#{nwurl}/members";
          $('.authCheck').on('change', function() {
            // Update status text immediately for better UX
            const statusSpan = $(this).closest('tr').find('.status-text');
            if(this.checked) {
              statusSpan.removeClass('status-pending').addClass('status-authorized').text('已授权');
            } else {
              statusSpan.removeClass('status-authorized').addClass('status-pending').text('未授权');
            }
            $.post(url, {'id': this.value, 'auth': this.checked});
          });
          $('.bridgeCheck').on('click', function() {
            const statusSpan = $(this).closest('.checkbox-wrapper').find('span').last();
            statusSpan.text(this.checked ? '已开启' : '未开启');
            $.post(url, {'id': this.value, 'activeBridge': this.checked});
          });
          $('.text').on('change', function() {
            $.post(url, {'id': this.name, 'name': this.value});
          });
          $('.member-pin-button').on('click', function(event) {
            event.preventDefault();
            event.stopPropagation();
            const button = $(this);
            const memberId = button.data('member-id');
            const nextPinned = button.data('pinned') !== true && button.data('pinned') !== 'true';
            $.post("#{nwurl}/member/" + memberId + "/pin", {'pinned': nextPinned})
              .done(function() {
                window.location.reload();
              });
          });
        });

      .table-responsive
        table.table.table-hover
          thead
            tr
              th(width='25%' style='text-align: center;') 名称 / 描述
              th(width='15%' style='text-align: center;') 地址 (ID)
              th(width='10%' style='text-align: center;') 授权状态
              th(width='10%' style='text-align: center;') 主动桥接
              th(width='15%' style='text-align: center;')
                .member-sort-heading
                  span 托管 IP
                  .member-sort-controls(aria-label='托管 IP 排序')
                    a.member-sort-button(href=(nwurl + '?ipSort=asc') title='升序' class=(currentIpSort === 'asc' ? 'is-active' : '')) ▲
                    a.member-sort-button(href=(nwurl + '?ipSort=desc') title='降序' class=(currentIpSort === 'desc' ? 'is-active' : '')) ▼
                    a.member-sort-button(href=nwurl title='恢复原始排序' class=(currentIpSort === '' ? 'is-active' : '')) ↕
              th(width='15%' style='text-align: center;') 物理地址
              th(width='10%' style='text-align: center;') 状态
              th(width='5%')
          tbody
            each member in members
              - const peer = member.peer;
              - const url = nwurl + '/member/' + member.id
              tr(class=(member.pinned ? 'member-row-pinned' : ''))
                td(style='text-align: center; min-width: 200px;')
                   .member-name-cell
                     button.member-pin-button(type='button' data-member-id=member.id data-pinned=(member.pinned ? 'true' : 'false') title=(member.pinned ? '取消置顶' : '置顶设备') aria-label=(member.pinned ? '取消置顶设备' : '置顶设备') class=(member.pinned ? 'is-pinned' : ''))
                       i.glyphicon.glyphicon-pushpin
                     input.form-control.text.member-name-input(type='text' name=member.id value=member.name onclick='event.stopPropagation();' placeholder='为设备命名' style='width: 100%;')
                td(style='text-align: center;')
                   div(style='display: flex; align-items: center; justify-content: center; gap: 12px;')
                     div(style='text-align: left;')
                       div(style='font-family: var(--font-mono); color: var(--text-heading); font-weight: 500;') #{member.id}
                       if peer
                         div(style='font-size: 0.75em; color: var(--text-muted);') v#{peer.version}
                     a(href=url title='配置成员' style='width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; border-radius: 50%; background-color: #F4F6F8; color: var(--text-muted); transition: all 0.2s;')
                       i.glyphicon.glyphicon-cog(style='font-size: 1.1em;')
                td(onclick='event.stopPropagation();' style='text-align: center;')
                   div.checkbox-wrapper(style='display: flex; flex-direction: column; align-items: center; gap: 6px;')
                     label.custom-checkbox
                       input.authCheck(type='checkbox' value=member.id checked=(member.authorized? true : false))
                       span.checkmark
                     span.status-text(style='font-size: 0.8em; min-width: auto; color: var(--text-muted);') #{member.authorized ? '已授权' : '未授权'}
                td(onclick='event.stopPropagation();' style='text-align: center;')
                   div.checkbox-wrapper(style='display: flex; flex-direction: column; align-items: center; gap: 6px;')
                     label.custom-checkbox
                       input.bridgeCheck(type='checkbox' value=member.id checked=(member.activeBridge? true : false))
                       span.checkmark
                     span(style='font-size: 0.8em; min-width: auto; color: var(--text-muted);') #{member.activeBridge ? '已开启' : '未开启'}
                td(style='text-align: center;')
                   if member.ipAssignments && member.ipAssignments.length > 0
                     each ipAssignment in member.ipAssignments
                       - const isIPv6 = ipAssignment.includes(':');
                       div.ip-copy-container(onclick=`copyToClipboard('${ipAssignment}')` title='点击复制' style='display: flex; align-items: center; justify-content: center; gap: 6px; cursor: pointer; padding: 2px;')
                         span.ip-chip(style=`font-family: var(--font-mono); font-size: ${isIPv6 ? '0.75em' : '0.85em'}; padding: 2px 8px; border-radius: 4px; background: ${isIPv6 ? 'rgba(76, 175, 80, 0.1)' : 'rgba(33, 150, 243, 0.1)'}; color: ${isIPv6 ? '#4CAF50' : '#2196F3'}; display: inline-flex; align-items: center; gap: 4px;`)
                           if isIPv6
                             span(style='font-size: 0.9em;') 🌐
                           | #{ipAssignment}
                         i.glyphicon.glyphicon-copy(style='font-size: 0.85em; color: var(--text-muted); opacity: 0.7;')
                   else
                     span(style='color: var(--text-muted); font-size: 0.9em;') 未分配 IP
                td(style='text-align: center;')
                   if (peer && peer.paths && peer.paths.length > 0)
                     each path in peer.paths
                       div(style='font-family: var(--font-mono); font-size: 0.85em; color: var(--text-muted);') #{path.address}
                   else if (peer)
                     span(style='color: var(--text-muted); font-size: 0.9em;') 无直连路径
                   else
                     span(style='color: var(--text-muted); font-size: 0.9em;') -
                td(style='text-align: center;')
                   - const hasLatency = peer && peer.latency != -1;
                   - const isOnline = !!peer;
                   if (member.id == zt_address)
                     span(style='color: var(--primary); font-weight: 700;') 控制器
                   else if (isOnline)
                     span(style='color: #22C55E; font-weight: 700;') 在线
                     if hasLatency
                       span(style='color: #2196F3; font-weight: 700;')  (#{peer.latency}ms)
                   else
                     span(style='color: #FF4842; font-weight: 700;') 离线
                td(onclick='event.stopPropagation();')
                   a.btn.btn-danger.btn-xs(href=url + '/delete' title='删除成员' style='background: transparent; border: none; color: #919EAB;')
                     i.glyphicon.glyphicon-trash(style='font-size: 1.2em;')
            else
              tr
                td(colspan='8' style='text-align: center; padding: 40px;')
                  div(style='color: var(--text-muted);') 暂无设备加入此网络。
                  div(style='margin-top: 8px;') 分享网络 ID 
                    code #{network.nwid} 
                    |  以连接设备。
 
 
  a.btn.btn-default(href='' name='refresh' role='button' style='margin-bottom: 24px;') 刷新

  // Network Details Card
  .panel.panel-default
    .panel-heading(style='cursor: pointer;' onclick="$('#network-details-body').collapse('toggle');")
      | 网络详细信息
      i.glyphicon.glyphicon-chevron-down.pull-right(style="color: var(--text-muted); font-size: 0.8em;")
    .panel-body.collapse#network-details-body
      .detail-grid
        each value, key in network
          if key !== 'routes' && key !== 'ipAssignmentPools' && key !== 'rules'
            .detail-item
              .detail-label= key
              .detail-value
                +json_value(value)

  a.btn.btn-default(href=(basePath + '/networks') name='networks' role='button') 返回网络列表

  script.
    function copyToClipboard(text) {
      const copyText = text;
      if (navigator.clipboard) {
        navigator.clipboard.writeText(copyText).then(showToast, (err) => console.error('Copy failed', err));
      } else {
        var textArea = document.createElement("textarea");
        textArea.value = copyText;
        document.body.appendChild(textArea);
        textArea.select();
        try { document.execCommand('copy'); showToast(); } catch (err) {}
        document.body.removeChild(textArea);
      }

      function showToast() {
        var toast = document.createElement('div');
        toast.innerText = '已复制: ' + copyText;
        toast.style.position = 'fixed';
        toast.style.bottom = '24px';
        toast.style.left = '50%';
        toast.style.transform = 'translateX(-50%)';
        toast.style.backgroundColor = 'rgba(22, 28, 36, 0.9)';
        toast.style.color = '#fff';
        toast.style.padding = '8px 16px';
        toast.style.borderRadius = '8px';
        toast.style.zIndex = '9999';
        toast.style.fontSize = '0.9rem';
        toast.style.boxShadow = '0 4px 12px rgba(0,0,0,0.15)';
        toast.style.backdropFilter = 'blur(6px)';
        document.body.appendChild(toast);
        setTimeout(() => {
          toast.style.transition = 'opacity 0.5s ease';
          toast.style.opacity = '0';
          setTimeout(() => document.body.removeChild(toast), 500);
        }, 2000);
      }
    }

extends network_layout

//- Don't display that title
block title

//- Replace the network title with the editable one
block network_title
  h2
    | 网络 
    a#change-name(href='#')
      span#name= network.name
      i.glyphicon.glyphicon-pencil(style='font-size: 20px;')
    input#name-input.form-control(type='text' style='width: 200px; display: none;')
    |  (#{network.nwid}):
  script.
    $(function() {
      var nwurl = '#{basePath}/controller/network/#{network.nwid}';
      var name = !{JSON.stringify(network.name)};

      function toggleNameEditor(show) {
        $('#change-name').css('display', !show ? '' : 'none');
        $('#name-input').css('display', show ? 'inline-block' : 'none');
      }

      function submit() {
        var newName = $('#name-input').val();
        if (newName != name) {
          name = newName;
          $.post(nwurl + '/name', {'name': name})
            .done(function () {
              $('#name').text(newName);
            });
        }
        toggleNameEditor(false);
      }

      $('#change-name').on('click', function() {
        toggleNameEditor(true);
        $('#name-input').val(name);
        $('#name-input').focus();
      });
      $('#name-input').on('focusout', submit);
      $('#name-input').keypress(function (e) {
        if (e.which == 13) submit();
      });
    });

block net_content
  - const nwurl = basePath + '/controller/network/' + network.nwid;

  // Settings Card
  .panel.panel-default
    .panel-heading 设置
    .panel-body
      .row
        .col-md-12
          div(style='display: flex; gap: 10px; flex-wrap: wrap;')
            a.btn.btn-default(href=(nwurl + '/routes')) 路由
            a.btn.btn-default(href=(nwurl + '/ipAssignmentPools')) 地址分配池
            a.btn.btn-default(href=(nwurl + '/v4AssignMode')) IPv4 分配模式
            a.btn.btn-default(href=(nwurl + '/v6AssignMode')) IPv6 分配模式
            a.btn.btn-default(href=(nwurl + '/dns')) DNS
            a.btn.btn-default(href=(nwurl + '/easy')) 简易设置
            a.btn.btn-default(href=(nwurl + '/private')) #{network.private ? "私有" : "公有"}

  if (members !== undefined)
    // Members Card
    .panel.panel-default
      .panel-heading 
        | 成员 
        span.badge(style='margin-left: 8px; background-color: var(--primary-light); color: var(--primary);') #{members.length}
      
      script.
        $(function() {
          const url = "#{nwurl}/members";
          $('.authCheck').on('change', function() {
            // Update status text immediately for better UX
            const statusSpan = $(this).closest('tr').find('.status-text');
            if(this.checked) {
              statusSpan.removeClass('status-pending').addClass('status-authorized').text('已授权');
            } else {
              statusSpan.removeClass('status-authorized').addClass('status-pending').text('未授权');
            }
            $.post(url, {'id': this.value, 'auth': this.checked});
          });
          $('.bridgeCheck').on('click', function() {
            $.post(url, {'id': this.value, 'activeBridge': this.checked});
          });
          $('.text').on('change', function() {
            $.post(url, {'id': this.name, 'name': this.value});
          });
        });

      .table-responsive
        table.table.table-hover
          thead
            tr
              th(width='25%' style='text-align: center;') 名称 / 描述
              th(width='15%' style='text-align: center;') 地址 (ID)
              th(width='10%' style='text-align: center;') 授权状态
              th(width='17.5%' style='text-align: center;') 托管 IP
              th(width='17.5%' style='text-align: center;') 物理地址
              th(width='10%' style='text-align: center;') 状态
              th(width='5%')
          tbody
            each member in members
              - const peer = member.peer;
              - const url = nwurl + '/member/' + member.id
              tr
                td(style='text-align: center; min-width: 200px;')
                   input.form-control.text(type='text' name=member.id value=member.name onclick='event.stopPropagation();' placeholder='为设备命名' style='width: 100%;')
                td(style='text-align: center;')
                   div(style='display: flex; align-items: center; justify-content: center; gap: 12px;')
                     div(style='text-align: left;')
                       div(style='font-family: var(--font-mono); color: var(--text-heading); font-weight: 500;') #{member.id}
                       if peer
                         div(style='font-size: 0.75em; color: var(--text-muted);') v#{peer.version}
                     a(href=url title='配置成员' style='width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; border-radius: 50%; background-color: #F4F6F8; color: var(--text-muted); transition: all 0.2s;')
                       i.glyphicon.glyphicon-cog(style='font-size: 1.1em;')
                td(onclick='event.stopPropagation();' style='text-align: center;')
                   div.checkbox-wrapper(style='display: flex; flex-direction: column; align-items: center; gap: 6px;')
                     label.custom-checkbox
                       input.authCheck(type='checkbox' value=member.id checked=(member.authorized? true : false))
                       span.checkmark
                     span.status-text(style='font-size: 0.8em; min-width: auto; color: var(--text-muted);') #{member.authorized ? '已授权' : '未授权'}
                td(style='text-align: center;')
                   each ipAssignment in member.ipAssignments
                     div.ip-copy-container(onclick=`copyToClipboard('${ipAssignment}')` title='点击复制' style='display: flex; align-items: center; justify-content: center; gap: 6px; cursor: pointer; padding: 2px;')
                       span.ip-chip #{ipAssignment}
                       i.glyphicon.glyphicon-copy(style='font-size: 0.85em; color: var(--text-muted); opacity: 0.7;')
                   else
                     span(style='color: var(--text-muted); font-size: 0.9em;') 未分配 IP
                td(style='text-align: center;')
                   if (peer && peer.paths)
                     each path in peer.paths
                       div(style='font-family: var(--font-mono); font-size: 0.85em; color: var(--text-muted);') #{path.address}
                   else
                     span(style='color: var(--text-muted); font-size: 0.9em;') -
                td(style='text-align: center;')
                   if (peer && peer.latency != -1)
                     span(style='color: #22C55E; font-weight: 700;') 在线 
                     span(style='color: #2196F3; font-weight: 700;') (#{peer.latency}ms)
                   else if (member.id == zt_address)
                     span(style='color: var(--primary); font-weight: 700;') 控制器
                   else
                     span(style='color: #FF4842; font-weight: 700;') 离线
                td(onclick='event.stopPropagation();')
                   a.btn.btn-danger.btn-xs(href=url + '/delete' title='删除成员' style='background: transparent; border: none; color: #919EAB;')
                     i.glyphicon.glyphicon-trash(style='font-size: 1.2em;')
            else
              tr
                td(colspan='6' style='text-align: center; padding: 40px;')
                  div(style='color: var(--text-muted);') 暂无设备加入此网络。
                  div(style='margin-top: 8px;') 分享网络 ID 
                    code #{network.nwid} 
                    |  以连接设备。
 
 
  a.btn.btn-default(href='' name='refresh' role='button' style='margin-bottom: 24px;') 刷新

  // Network Details Card
  .panel.panel-default
    .panel-heading(style='cursor: pointer;' onclick="$('#network-details-body').collapse('toggle');")
      | 网络详细信息
      i.glyphicon.glyphicon-chevron-down.pull-right(style="color: var(--text-muted); font-size: 0.8em;")
    .panel-body.collapse#network-details-body
      .detail-grid
        each value, key in network
          if key !== 'routes' && key !== 'ipAssignmentPools' && key !== 'rules'
            .detail-item
              .detail-label= key
              .detail-value
                +json_value(value)

  a.btn.btn-default(href=(basePath + '/controller/networks') name='networks' role='button') 返回网络列表

  script.
    function copyToClipboard(text) {
      const copyText = text;
      if (navigator.clipboard) {
        navigator.clipboard.writeText(copyText).then(showToast, (err) => console.error('Copy failed', err));
      } else {
        var textArea = document.createElement("textarea");
        textArea.value = copyText;
        document.body.appendChild(textArea);
        textArea.select();
        try { document.execCommand('copy'); showToast(); } catch (err) {}
        document.body.removeChild(textArea);
      }

      function showToast() {
        var toast = document.createElement('div');
        toast.innerText = '已复制: ' + copyText;
        toast.style.position = 'fixed';
        toast.style.bottom = '24px';
        toast.style.left = '50%';
        toast.style.transform = 'translateX(-50%)';
        toast.style.backgroundColor = 'rgba(22, 28, 36, 0.9)';
        toast.style.color = '#fff';
        toast.style.padding = '8px 16px';
        toast.style.borderRadius = '8px';
        toast.style.zIndex = '9999';
        toast.style.fontSize = '0.9rem';
        toast.style.boxShadow = '0 4px 12px rgba(0,0,0,0.15)';
        toast.style.backdropFilter = 'blur(6px)';
        document.body.appendChild(toast);
        setTimeout(() => {
          toast.style.transition = 'opacity 0.5s ease';
          toast.style.opacity = '0';
          setTimeout(() => document.body.removeChild(toast), 500);
        }, 2000);
      }
    }
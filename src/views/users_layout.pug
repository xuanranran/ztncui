extends head_layout

block nav_items
  +nav_item('networks', '网络', basePath + '/networks', 'glyphicon-cloud', ['add_network', 'controller_home'])
  +nav_item('users', '用户', basePath + '/users', 'glyphicon-user', ['create_user'])

block body_content
  .container(style='margin-top:50px')
    .row
      .col-sm-12
        if error
           b #{error}
        else
          block users_header
            h1= title
          block users_content
